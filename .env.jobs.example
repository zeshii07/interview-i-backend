# Job search — required env vars (add to .env or your host's environment panel)

# Adzuna — https://developer.adzuna.com/ (sign up, get app_id + app_key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Jooble — https://jooble.org/api/about (request partner API key)
JOOBLE_API_KEY=

# Reed.co.uk — https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# USAJobs.gov — https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=Hirely/1.0 (contact@hirely.app)
