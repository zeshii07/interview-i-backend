# Job search + Interview readiness — required env vars

# ─── Job providers (at least one recommended; Adzuna covers most countries) ───
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=

# Reed.co.uk (UK only): https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# USAJobs (US federal jobs): https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=Hirely/1.0 (contact@hirely.app)

# ─── Interview readiness (Firebase Admin SDK — reads user's interview history from RTDB) ───
# Option A: Render/GCP auto-injects credentials — leave these blank
# Option B: Local dev — download service account JSON from Firebase console →
#           Project Settings → Service Accounts → Generate new private key,
#           then set these env vars from the JSON contents:
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://hirely-8f434-default-rtdb.firebaseio.com
